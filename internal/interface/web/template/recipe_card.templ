package template

import (
	"fmt"
	"github.com/tyler/recipebox/internal/application/dto"
)

templ RecipeCard(r dto.RecipeResult) {
	<div class="card">
		if r.ImageURL != "" {
			<div class="card-image">
				<img src={ r.ImageURL } alt={ r.Title }/>
			</div>
		}
		<div class="card-body">
			<p class="title title-sm">
				<a href={ templ.SafeURL(fmt.Sprintf("/recipes/%s", r.ID)) }>{ r.Title }</a>
			</p>
			if r.Author != "" {
				<p class="subtitle">by { r.Author }</p>
			}
			<div class="tag-group">
				if r.TotalTime != "" {
					<span class="tag tag-info">{ r.TotalTime }</span>
				}
				if r.Cuisine != "" {
					<span class="tag tag-success">{ r.Cuisine }</span>
				}
				if r.Course != "" {
					<span class="tag tag-warning">{ r.Course }</span>
				}
				if r.Servings != "" {
					<span class="tag tag-primary">{ fmt.Sprintf("Serves %s", r.Servings) }</span>
				}
			</div>
		</div>
	</div>
}
