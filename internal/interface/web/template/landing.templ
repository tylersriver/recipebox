package template

templ LandingLayout() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>RecipeBox — Save, Organize &amp; Share Your Favorite Recipes</title>
			<meta name="description" content="Import recipes from any website with one click. Organize your personal cookbook, add notes, and share favorites with friends. Free to use."/>
			<meta name="robots" content="index, follow"/>
			<link rel="canonical" href="https://recipebox.app/"/>
			<!-- Open Graph -->
			<meta property="og:type" content="website"/>
			<meta property="og:title" content="RecipeBox — Save, Organize & Share Your Favorite Recipes"/>
			<meta property="og:description" content="Import recipes from any website with one click. Organize your personal cookbook, add notes, and share favorites with friends."/>
			<meta property="og:url" content="https://recipebox.app/"/>
			<meta property="og:site_name" content="RecipeBox"/>
			<!-- Twitter Card -->
			<meta name="twitter:card" content="summary"/>
			<meta name="twitter:title" content="RecipeBox — Save, Organize & Share Recipes"/>
			<meta name="twitter:description" content="Import recipes from any website with one click. Organize your personal cookbook and share favorites with friends."/>
			<!-- Structured Data -->
			<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebApplication",
				"name": "RecipeBox",
				"description": "Import recipes from any website with one click. Organize your personal cookbook, add notes, and share favorites with friends.",
				"url": "https://recipebox.app/",
				"applicationCategory": "LifestyleApplication",
				"operatingSystem": "All",
				"offers": {
					"@type": "Offer",
					"price": "0",
					"priceCurrency": "USD"
				}
			}
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body>
			<nav class="navbar">
				<div class="container">
					<a class="navbar-brand" href="/">RecipeBox</a>
					<div class="navbar-end" style="flex-direction:row;margin-left:auto;">
						<a href="/login" class="btn btn-ghost btn-sm">Login</a>
						<a href="/register" class="btn btn-primary btn-sm">Get Started</a>
					</div>
				</div>
			</nav>
			<div class="page-content">
				{ children... }
			</div>
		</body>
	</html>
}

templ Landing() {
	@LandingLayout() {
		<section class="landing-hero">
			<div class="container">
				<h1 class="landing-headline">Your recipes,<br/>all in one place</h1>
				<p class="landing-subheadline">Import recipes from any website with one click. Keep your personal cookbook organized, add your own notes, and share favorites with friends.</p>
				<div class="landing-cta">
					<a href="/register" class="btn btn-primary btn-lg">Create Free Account</a>
					<a href="/login" class="btn btn-ghost btn-lg">Login</a>
				</div>
			</div>
		</section>
		<section class="landing-features">
			<div class="container">
				<h2 class="landing-section-title">How It Works</h2>
				<div class="feature-grid">
					<div class="feature-card">
						<div class="feature-step">1</div>
						<h3 class="feature-title">Paste a URL</h3>
						<p class="feature-desc">Find a recipe you love on any website. Copy the link and paste it into RecipeBox.</p>
					</div>
					<div class="feature-card">
						<div class="feature-step">2</div>
						<h3 class="feature-title">Auto-Import</h3>
						<p class="feature-desc">We extract the ingredients, instructions, cook times, and photo automatically. No manual entry needed.</p>
					</div>
					<div class="feature-card">
						<div class="feature-step">3</div>
						<h3 class="feature-title">Cook &amp; Customize</h3>
						<p class="feature-desc">Add your own notes and tweaks. Search your collection by ingredient, cuisine, or name.</p>
					</div>
				</div>
			</div>
		</section>
		<section class="landing-benefits">
			<div class="container">
				<div class="benefit-grid">
					<div class="benefit-item">
						<h3 class="benefit-title">No More Ad-Filled Recipe Sites</h3>
						<p class="benefit-desc">Imported recipes show just what matters: ingredients and instructions. Clean, fast, and distraction-free.</p>
					</div>
					<div class="benefit-item">
						<h3 class="benefit-title">Full-Text Search</h3>
						<p class="benefit-desc">Search across recipe names, ingredients, and cuisines. Find exactly what you want to cook in seconds.</p>
					</div>
					<div class="benefit-item">
						<h3 class="benefit-title">Share With Anyone</h3>
						<p class="benefit-desc">Generate a shareable link for any recipe. Friends can view it without needing an account.</p>
					</div>
					<div class="benefit-item">
						<h3 class="benefit-title">Your Notes, Your Way</h3>
						<p class="benefit-desc">Add personal notes to any recipe. Track your tweaks, substitutions, and tips for next time.</p>
					</div>
				</div>
			</div>
		</section>
		<section class="landing-final-cta">
			<div class="container text-center">
				<h2 class="landing-section-title">Start building your cookbook</h2>
				<p class="landing-subheadline">Free to use. No credit card required.</p>
				<div class="landing-cta">
					<a href="/register" class="btn btn-primary btn-lg">Get Started</a>
				</div>
			</div>
		</section>
	}
}
