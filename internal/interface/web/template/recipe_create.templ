package template

templ RecipeCreate(userEmail string) {
	@Layout("Add Recipe", userEmail) {
		<h1 class="page-title">Add Recipe</h1>
		<p class="page-subtitle">Manually add a recipe to your collection.</p>
		<form method="POST" action="/recipes/create">
			<div class="grid">
				<div class="col-8">
					<div class="panel">
						<div class="form-group">
							<label class="form-label" for="title">Title *</label>
							<input class="form-input" type="text" id="title" name="title" required placeholder="e.g. Grandma's Chocolate Chip Cookies"/>
						</div>
						<div class="form-group">
							<label class="form-label" for="description">Description</label>
							<textarea class="form-textarea" id="description" name="description" placeholder="A short description of the recipe..." style="min-height:80px;"></textarea>
						</div>
					</div>
					<div class="panel">
						<h2 class="section-title">Ingredients</h2>
						<div id="ingredients-list">
							<div class="form-group ingredient-row">
								<input class="form-input" type="text" name="ingredients" placeholder="e.g. 2 cups all-purpose flour"/>
							</div>
							<div class="form-group ingredient-row">
								<input class="form-input" type="text" name="ingredients" placeholder="e.g. 1 tsp vanilla extract"/>
							</div>
							<div class="form-group ingredient-row">
								<input class="form-input" type="text" name="ingredients" placeholder="e.g. 1/2 cup butter, softened"/>
							</div>
						</div>
						<button class="btn btn-ghost btn-sm" type="button" onclick="addIngredient()">+ Add Ingredient</button>
					</div>
					<div class="panel">
						<h2 class="section-title">Instructions</h2>
						<div id="instructions-list">
							<div class="form-group instruction-row">
								<label class="form-label">Step 1</label>
								<textarea class="form-textarea" name="instructions" placeholder="Describe this step..." style="min-height:60px;"></textarea>
							</div>
							<div class="form-group instruction-row">
								<label class="form-label">Step 2</label>
								<textarea class="form-textarea" name="instructions" placeholder="Describe this step..." style="min-height:60px;"></textarea>
							</div>
						</div>
						<button class="btn btn-ghost btn-sm" type="button" onclick="addInstruction()">+ Add Step</button>
					</div>
					<div class="panel">
						<h2 class="section-title">Details</h2>
						<div class="grid" style="gap:1rem;">
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="prep_time">Prep Time</label>
									<input class="form-input" type="text" id="prep_time" name="prep_time" placeholder="e.g. 15 min"/>
								</div>
							</div>
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="cook_time">Cook Time</label>
									<input class="form-input" type="text" id="cook_time" name="cook_time" placeholder="e.g. 30 min"/>
								</div>
							</div>
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="total_time">Total Time</label>
									<input class="form-input" type="text" id="total_time" name="total_time" placeholder="e.g. 45 min"/>
								</div>
							</div>
						</div>
						<div class="grid" style="gap:1rem;">
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="servings">Servings</label>
									<input class="form-input" type="text" id="servings" name="servings" placeholder="e.g. 4"/>
								</div>
							</div>
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="cuisine">Cuisine</label>
									<input class="form-input" type="text" id="cuisine" name="cuisine" placeholder="e.g. Italian"/>
								</div>
							</div>
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="course">Course</label>
									<input class="form-input" type="text" id="course" name="course" placeholder="e.g. Dessert"/>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="form-label" for="image_url">Image URL</label>
							<input class="form-input" type="url" id="image_url" name="image_url" placeholder="https://example.com/photo.jpg"/>
						</div>
					</div>
					<div class="form-group">
						<button class="btn btn-primary" type="submit">Save Recipe</button>
						<a href="/recipes" class="btn btn-ghost" style="margin-left:0.5rem;">Cancel</a>
					</div>
				</div>
			</div>
		</form>
		<script>
			function addIngredient() {
				var list = document.getElementById('ingredients-list');
				var div = document.createElement('div');
				div.className = 'form-group ingredient-row';
				div.innerHTML = '<input class="form-input" type="text" name="ingredients" placeholder="e.g. 1 cup sugar"/>';
				list.appendChild(div);
				div.querySelector('input').focus();
			}
			function addInstruction() {
				var list = document.getElementById('instructions-list');
				var count = list.querySelectorAll('.instruction-row').length + 1;
				var div = document.createElement('div');
				div.className = 'form-group instruction-row';
				div.innerHTML = '<label class="form-label">Step ' + count + '</label><textarea class="form-textarea" name="instructions" placeholder="Describe this step..." style="min-height:60px;"></textarea>';
				list.appendChild(div);
				div.querySelector('textarea').focus();
			}
		</script>
	}
}

templ RecipeCreateSuccess(title string, id string) {
	<div id="create-result" class="alert alert-success mt-2">
		<p>
			Successfully created <strong>{ title }</strong>!
		</p>
		<a href={ templ.SafeURL("/recipes/" + id) } class="btn btn-ghost btn-sm mt-1">View Recipe</a>
	</div>
}

templ RecipeCreateError(msg string) {
	<div id="create-result" class="alert alert-danger mt-2">
		<p>{ msg }</p>
	</div>
}
