package template

import (
	"fmt"
	"github.com/tyler/recipebox/internal/application/dto"
)

templ RecipeEdit(r dto.RecipeResult, userEmail string) {
	@Layout("Edit Recipe", userEmail) {
		<h1 class="page-title">Edit Recipe</h1>
		<p class="page-subtitle">Update the details of your recipe.</p>
		<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/recipes/%s/edit", r.ID)) }>
			<div class="grid">
				<div class="col-8">
					<div class="panel">
						<div class="form-group">
							<label class="form-label" for="title">Title *</label>
							<input class="form-input" type="text" id="title" name="title" required value={ r.Title } placeholder="e.g. Grandma's Chocolate Chip Cookies"/>
						</div>
						<div class="form-group">
							<label class="form-label" for="description">Description</label>
							<textarea class="form-textarea" id="description" name="description" placeholder="A short description of the recipe..." style="min-height:80px;">{ r.Description }</textarea>
						</div>
					</div>
					<div class="panel">
						<h2 class="section-title">Ingredients</h2>
						<div id="ingredients-list">
							for _, ing := range r.Ingredients {
								<div class="form-group ingredient-row">
									<input class="form-input" type="text" name="ingredients" value={ ingredientDisplay(ing) } placeholder="e.g. 2 cups all-purpose flour"/>
								</div>
							}
							<div class="form-group ingredient-row">
								<input class="form-input" type="text" name="ingredients" placeholder="e.g. 2 cups all-purpose flour"/>
							</div>
						</div>
						<button class="btn btn-ghost btn-sm" type="button" onclick="addIngredient()">+ Add Ingredient</button>
					</div>
					<div class="panel">
						<h2 class="section-title">Instructions</h2>
						<div id="instructions-list">
							for i, inst := range r.Instructions {
								<div class="form-group instruction-row">
									<label class="form-label">{ fmt.Sprintf("Step %d", i+1) }</label>
									<textarea class="form-textarea" name="instructions" placeholder="Describe this step..." style="min-height:60px;">{ inst.Text }</textarea>
								</div>
							}
							<div class="form-group instruction-row">
								<label class="form-label">{ fmt.Sprintf("Step %d", len(r.Instructions)+1) }</label>
								<textarea class="form-textarea" name="instructions" placeholder="Describe this step..." style="min-height:60px;"></textarea>
							</div>
						</div>
						<button class="btn btn-ghost btn-sm" type="button" onclick="addInstruction()">+ Add Step</button>
					</div>
					<div class="panel">
						<h2 class="section-title">Details</h2>
						<div class="grid" style="gap:1rem;">
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="prep_time">Prep Time</label>
									<input class="form-input" type="text" id="prep_time" name="prep_time" value={ r.PrepTime } placeholder="e.g. 15 min"/>
								</div>
							</div>
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="cook_time">Cook Time</label>
									<input class="form-input" type="text" id="cook_time" name="cook_time" value={ r.CookTime } placeholder="e.g. 30 min"/>
								</div>
							</div>
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="total_time">Total Time</label>
									<input class="form-input" type="text" id="total_time" name="total_time" value={ r.TotalTime } placeholder="e.g. 45 min"/>
								</div>
							</div>
						</div>
						<div class="grid" style="gap:1rem;">
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="servings">Servings</label>
									<input class="form-input" type="text" id="servings" name="servings" value={ r.Servings } placeholder="e.g. 4"/>
								</div>
							</div>
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="cuisine">Cuisine</label>
									<input class="form-input" type="text" id="cuisine" name="cuisine" value={ r.Cuisine } placeholder="e.g. Italian"/>
								</div>
							</div>
							<div class="col-4">
								<div class="form-group">
									<label class="form-label" for="course">Course</label>
									<input class="form-input" type="text" id="course" name="course" value={ r.Course } placeholder="e.g. Dessert"/>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="form-label" for="image_url">Image URL</label>
							<input class="form-input" type="url" id="image_url" name="image_url" value={ r.ImageURL } placeholder="https://example.com/photo.jpg"/>
						</div>
					</div>
					<div class="form-group">
						<button class="btn btn-primary" type="submit">Save Changes</button>
						<a href={ templ.SafeURL(fmt.Sprintf("/recipes/%s", r.ID)) } class="btn btn-ghost" style="margin-left:0.5rem;">Cancel</a>
					</div>
				</div>
			</div>
		</form>
		<script>
			function addIngredient() {
				var list = document.getElementById('ingredients-list');
				var div = document.createElement('div');
				div.className = 'form-group ingredient-row';
				div.innerHTML = '<input class="form-input" type="text" name="ingredients" placeholder="e.g. 1 cup sugar"/>';
				list.appendChild(div);
				div.querySelector('input').focus();
			}
			function addInstruction() {
				var list = document.getElementById('instructions-list');
				var count = list.querySelectorAll('.instruction-row').length + 1;
				var div = document.createElement('div');
				div.className = 'form-group instruction-row';
				div.innerHTML = '<label class="form-label">Step ' + count + '</label><textarea class="form-textarea" name="instructions" placeholder="Describe this step..." style="min-height:60px;"></textarea>';
				list.appendChild(div);
				div.querySelector('textarea').focus();
			}
		</script>
	}
}
