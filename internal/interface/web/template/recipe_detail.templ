package template

import (
	"fmt"
	"strings"
	"github.com/tyler/recipebox/internal/application/dto"
)

func ingredientDisplay(ing dto.IngredientResult) string {
	if ing.Raw != "" {
		return ing.Raw
	}
	s := ""
	if ing.Amount != "" {
		s += ing.Amount + " "
	}
	if ing.Unit != "" {
		s += ing.Unit + " "
	}
	s += ing.Name
	if ing.Notes != "" {
		s += ", " + ing.Notes
	}
	return s
}

templ RecipeDetail(r dto.RecipeResult, userEmail string) {
	@Layout(r.Title, userEmail) {
		<div class="grid">
			<div class="col-8">
				<!-- View Mode -->
				<div id="view-mode">
					<h1 class="page-title">{ r.Title }</h1>
					if r.Author != "" {
						<p class="text-secondary mb-2">by { r.Author }</p>
					}
					if r.Description != "" {
						<p class="mb-3">{ r.Description }</p>
					}
					<div class="badge-group mb-3">
						if r.PrepTime != "" {
							<span class="badge badge-info">{ fmt.Sprintf("Prep: %s", r.PrepTime) }</span>
						}
						if r.CookTime != "" {
							<span class="badge badge-info">{ fmt.Sprintf("Cook: %s", r.CookTime) }</span>
						}
						if r.TotalTime != "" {
							<span class="badge badge-info">{ fmt.Sprintf("Total: %s", r.TotalTime) }</span>
						}
						if r.Servings != "" {
							<span class="badge badge-accent">{ fmt.Sprintf("Serves %s", r.Servings) }</span>
						}
						if r.Cuisine != "" {
							<span class="badge badge-success">{ r.Cuisine }</span>
						}
						if r.Course != "" {
							<span class="badge badge-warning">{ r.Course }</span>
						}
					</div>
					<div class="mb-3 no-print">
						<button class="btn btn-ghost btn-sm" id="share-btn" onclick="shareRecipe(event)">Share Recipe</button>
						<button class="btn btn-ghost btn-sm" onclick="window.print()">Print Recipe</button>
						<button class="btn btn-ghost btn-sm" id="edit-btn" onclick="toggleEditMode()">Edit</button>
						<span id="share-result" class="ml-1"></span>
					</div>
					<div class="panel">
						<h2 class="section-title">Ingredients</h2>
						<ul>
							for _, ing := range r.Ingredients {
								<li>{ ingredientDisplay(ing) }</li>
							}
						</ul>
					</div>
					<div class="panel">
						<h2 class="section-title">Instructions</h2>
						<ol>
							for _, inst := range r.Instructions {
								<li class="mb-1">{ inst.Text }</li>
							}
						</ol>
					</div>
				</div>
				<!-- Edit Mode -->
				<div id="edit-mode" style="display:none;" class="no-print">
					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/recipes/%s/edit", r.ID)) } enctype="multipart/form-data">
						<div class="panel">
							<div class="form-group">
								<label class="form-label" for="edit-title">Title *</label>
								<input class="form-input" type="text" id="edit-title" name="title" required value={ r.Title }/>
							</div>
							<div class="form-group">
								<label class="form-label" for="edit-description">Description</label>
								<textarea class="form-textarea" id="edit-description" name="description" style="min-height:80px;">{ r.Description }</textarea>
							</div>
						</div>
						<div class="panel">
							<h2 class="section-title">Ingredients</h2>
							<div id="edit-ingredients-list">
								for _, ing := range r.Ingredients {
									<div class="form-group ingredient-row" style="display:flex;gap:0.5rem;align-items:center;">
										<input class="form-input" type="text" name="ingredients" value={ ingredientDisplay(ing) } style="flex:1;"/>
										<button class="btn btn-ghost btn-sm" type="button" onclick="this.parentElement.remove()">✕</button>
									</div>
								}
							</div>
							<button class="btn btn-ghost btn-sm" type="button" onclick="addEditIngredient()">+ Add Ingredient</button>
						</div>
						<div class="panel">
							<h2 class="section-title">Instructions</h2>
							<div id="edit-instructions-list">
								for _, inst := range r.Instructions {
									<div class="form-group instruction-row">
										<label class="form-label">{ fmt.Sprintf("Step %d", inst.StepNumber) }</label>
										<div style="display:flex;gap:0.5rem;align-items:start;">
											<textarea class="form-textarea" name="instructions" style="min-height:60px;flex:1;">{ inst.Text }</textarea>
											<button class="btn btn-ghost btn-sm" type="button" onclick="removeInstruction(this)">✕</button>
										</div>
									</div>
								}
							</div>
							<button class="btn btn-ghost btn-sm" type="button" onclick="addEditInstruction()">+ Add Step</button>
						</div>
						<div class="panel">
							<h2 class="section-title">Details</h2>
							<div class="grid" style="gap:1rem;">
								<div class="col-4">
									<div class="form-group">
										<label class="form-label" for="edit-prep-time">Prep Time</label>
										<input class="form-input" type="text" id="edit-prep-time" name="prep_time" value={ r.PrepTime } placeholder="e.g. 15 min"/>
									</div>
								</div>
								<div class="col-4">
									<div class="form-group">
										<label class="form-label" for="edit-cook-time">Cook Time</label>
										<input class="form-input" type="text" id="edit-cook-time" name="cook_time" value={ r.CookTime } placeholder="e.g. 30 min"/>
									</div>
								</div>
								<div class="col-4">
									<div class="form-group">
										<label class="form-label" for="edit-total-time">Total Time</label>
										<input class="form-input" type="text" id="edit-total-time" name="total_time" value={ r.TotalTime } placeholder="e.g. 45 min"/>
									</div>
								</div>
							</div>
							<div class="grid" style="gap:1rem;">
								<div class="col-4">
									<div class="form-group">
										<label class="form-label" for="edit-servings">Servings</label>
										<input class="form-input" type="text" id="edit-servings" name="servings" value={ r.Servings } placeholder="e.g. 4"/>
									</div>
								</div>
								<div class="col-4">
									<div class="form-group">
										<label class="form-label" for="edit-cuisine">Cuisine</label>
										<input class="form-input" type="text" id="edit-cuisine" name="cuisine" value={ r.Cuisine } placeholder="e.g. Italian"/>
									</div>
								</div>
								<div class="col-4">
									<div class="form-group">
										<label class="form-label" for="edit-course">Course</label>
										<input class="form-input" type="text" id="edit-course" name="course" value={ r.Course } placeholder="e.g. Dessert"/>
									</div>
								</div>
							</div>
						</div>
						<div class="panel">
							<h2 class="section-title">Recipe Photo</h2>
							<div class="form-group">
								<input type="file" name="image" accept="image/jpeg,image/png,image/webp" class="form-input"/>
								<small class="text-secondary">JPEG, PNG, or WebP. Max 10 MB. Leave empty to keep current photo.</small>
							</div>
						</div>
						<div class="form-group">
							<button class="btn btn-primary" type="submit">Save Changes</button>
							<button class="btn btn-ghost" type="button" onclick="toggleEditMode()" style="margin-left:0.5rem;">Cancel</button>
						</div>
					</form>
				</div>
				<!-- Notes (always visible) -->
				<div class="panel no-print">
					<h2 class="section-title">My Notes</h2>
					<form id="notes-form" onsubmit="saveNotes(event)">
						<div class="form-group">
							<textarea class="form-textarea" id="notes-input" name="notes" placeholder="Add your personal notes, tweaks, or modifications...">{ r.Notes }</textarea>
						</div>
						<div class="form-group">
							<button class="btn btn-primary" type="submit" id="notes-save-btn">Save Notes</button>
						</div>
					</form>
				</div>
				if r.Notes != "" {
					<div class="panel print-only">
						<h2 class="section-title">My Notes</h2>
						<p>{ r.Notes }</p>
					</div>
				}
				<div id="notes-toast" class="toast is-hidden no-print">
					<span id="notes-toast-msg"></span>
					<button class="toast-close" onclick="this.parentElement.classList.add('is-hidden')">&times;</button>
				</div>
				<script>
					function saveNotes(e) {
						e.preventDefault();
						var btn = document.getElementById('notes-save-btn');
						btn.classList.add('is-loading');
						var formData = new FormData(document.getElementById('notes-form'));
						fetch(window.location.pathname + '/notes', {
							method: 'POST',
							body: formData
						}).then(function(resp) {
							return resp.json().then(function(data) {
								return { ok: resp.ok, data: data };
							});
						}).then(function(result) {
							showNotesToast(result.ok ? result.data.message : result.data.error, result.ok);
						}).catch(function() {
							showNotesToast('Failed to save notes', false);
						}).finally(function() {
							btn.classList.remove('is-loading');
						});
					}
					function showNotesToast(msg, success) {
						var toast = document.getElementById('notes-toast');
						toast.className = 'toast ' + (success ? 'toast-success' : 'toast-danger');
						document.getElementById('notes-toast-msg').textContent = msg;
						setTimeout(function() { toast.classList.add('is-hidden'); }, 3000);
					}
				</script>
				<script>
					function toggleEditMode() {
						var viewMode = document.getElementById('view-mode');
						var editMode = document.getElementById('edit-mode');
						var isEditing = editMode.style.display !== 'none';
						viewMode.style.display = isEditing ? '' : 'none';
						editMode.style.display = isEditing ? 'none' : '';
					}
					function addEditIngredient() {
						var list = document.getElementById('edit-ingredients-list');
						var div = document.createElement('div');
						div.className = 'form-group ingredient-row';
						div.style.cssText = 'display:flex;gap:0.5rem;align-items:center;';
						div.innerHTML = '<input class="form-input" type="text" name="ingredients" placeholder="e.g. 1 cup sugar" style="flex:1;"/><button class="btn btn-ghost btn-sm" type="button" onclick="this.parentElement.remove()">✕</button>';
						list.appendChild(div);
						div.querySelector('input').focus();
					}
					function addEditInstruction() {
						var list = document.getElementById('edit-instructions-list');
						var count = list.querySelectorAll('.instruction-row').length + 1;
						var div = document.createElement('div');
						div.className = 'form-group instruction-row';
						div.innerHTML = '<label class="form-label">Step ' + count + '</label><div style="display:flex;gap:0.5rem;align-items:start;"><textarea class="form-textarea" name="instructions" placeholder="Describe this step..." style="min-height:60px;flex:1;"></textarea><button class="btn btn-ghost btn-sm" type="button" onclick="removeInstruction(this)">✕</button></div>';
						list.appendChild(div);
						div.querySelector('textarea').focus();
					}
					function removeInstruction(btn) {
						btn.closest('.instruction-row').remove();
						renumberSteps();
					}
					function renumberSteps() {
						var rows = document.querySelectorAll('#edit-instructions-list .instruction-row');
						for (var i = 0; i < rows.length; i++) {
							rows[i].querySelector('.form-label').textContent = 'Step ' + (i + 1);
						}
					}
				</script>
				<script>
					function shareRecipe(e) {
						e.preventDefault();
						var btn = document.getElementById('share-btn');
						var result = document.getElementById('share-result');
						btn.classList.add('is-loading');
						fetch(window.location.pathname + '/share', {
							method: 'POST'
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							if (data.url) {
								if (navigator.clipboard) {
									navigator.clipboard.writeText(data.url).then(function() {
										result.textContent = 'Link copied!';
									});
								} else {
									result.textContent = data.url;
								}
							} else {
								result.textContent = 'Failed to generate link';
							}
						}).catch(function() {
							result.textContent = 'Failed to generate link';
						}).finally(function() {
							btn.classList.remove('is-loading');
							setTimeout(function() { result.textContent = ''; }, 5000);
						});
					}
				</script>
				<div style="display:flex;justify-content:space-between;align-items:center;" class="mt-2 no-print">
					<div>
						if r.SourceURL != "" && !strings.HasPrefix(r.SourceURL, "manual://") {
							<p class="text-secondary">
								<a href={ templ.SafeURL(r.SourceURL) } target="_blank" rel="noopener">View original recipe</a>
							</p>
						}
					</div>
					<button class="btn btn-danger btn-sm" type="button" onclick="document.getElementById('delete-modal').classList.add('is-active')">Delete Recipe</button>
				</div>
				<div id="delete-modal" class="modal-overlay no-print" onclick="if(event.target===this)this.classList.remove('is-active')">
					<div class="modal">
						<div class="modal-title">Delete Recipe</div>
						<div class="modal-body">Are you sure you want to delete this recipe? This cannot be undone.</div>
						<div class="modal-actions">
							<button class="btn btn-ghost btn-sm" type="button" onclick="document.getElementById('delete-modal').classList.remove('is-active')">Cancel</button>
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/recipes/%s/delete", r.ID)) }>
								<button class="btn btn-danger btn-sm" type="submit">Delete</button>
							</form>
						</div>
					</div>
				</div>
			</div>
			<div class="col-4">
				if r.DisplayImageURL() != "" {
					<div class="recipe-image">
						<img src={ r.DisplayImageURL() } alt={ r.Title } id="recipe-image"/>
					</div>
				}
			</div>
		</div>
	}
}
